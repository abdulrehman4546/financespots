
# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# Old guide page 301 redirects (must be before WordPress catch-all)
RewriteRule ^mortgage-calculator-guide/?$ https://financespots.com/first-time-home-buyer-guide-2026/ [R=301,L]
RewriteRule ^compound-interest-guide/?$ https://financespots.com/index-fund-investing-beginners-guide-2026/ [R=301,L]
RewriteRule ^investment-calculator-guide/?$ https://financespots.com/index-fund-investing-beginners-guide-2026/ [R=301,L]
RewriteRule ^emergency-fund-guide/?$ https://financespots.com/emergency-fund-how-much-where-to-keep-2026/ [R=301,L]
RewriteRule ^tax-calculator-guide-2026/?$ https://financespots.com/tool/income-tax-calculator/ [R=301,L]
RewriteRule ^crypto-profit-guide/?$ https://financespots.com/bitcoin-vs-gold-better-investment-2026/ [R=301,L]
RewriteRule ^personal-loan-guide/?$ https://financespots.com/how-to-pay-off-student-loans-faster-2026/ [R=301,L]
RewriteRule ^budget-planner-guide/?$ https://financespots.com/50-30-20-budget-rule-guide-2026/ [R=301,L]
RewriteRule ^retirement-planning-guide/?$ https://financespots.com/retirement-planning-how-much-need-2026/ [R=301,L]
RewriteRule ^pay-off-debt-fast-guide/?$ https://financespots.com/how-to-pay-off-student-loans-faster-2026/ [R=301,L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress